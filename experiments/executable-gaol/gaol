#!/usr/bin/env bash
set -euo pipefail

experiment_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "$experiment_dir" rev-parse --show-toplevel)
output_rel=target/executable-gaol
output_dir="$repo_root/$output_rel"
mode=${1:-capture}
areas_dir="$experiment_dir/areas"

build() {
  if [[ -d $output_dir ]]; then
    find "$output_dir" -mindepth 1 -delete
  fi
  mkdir -p "$output_dir/areas" "$output_dir/frames"

  cd "$repo_root"
  cargo build --quiet --locked -p nomos-cli --bin nomos
  cargo build --quiet --locked -p nomos-render-plan --bin nomos-render-plan
  local area_dir
  for area_dir in "$areas_dir"/*; do
    [[ -d $area_dir ]] || continue
    local area_id area_output area_rel source_rel scenario
    area_id=$(basename "$area_dir")
    area_output="$output_dir/areas/$area_id"
    area_rel="$output_rel/areas/$area_id"
    source_rel=${area_dir#"$repo_root/"}/world.nomos
    mkdir -p "$area_output/runs" "$area_output/facts" "$area_output/frames"
    target/debug/nomos compile "$source_rel" --out "$area_rel/world"

    for scenario in "$area_dir"/scenarios/*.commands; do
      local name commands_rel
      name=$(basename "$scenario" .commands)
      commands_rel=${scenario#"$repo_root/"}
      if ! target/debug/nomos run "$area_rel/world" \
        --commands "$commands_rel" --out "$area_rel/runs/$name"; then
        [[ $name == 01-baseline ]] || return 1
      fi
      target/debug/nomos effective-facts "$area_rel/world" \
        --state "$area_rel/runs/$name/final-state.json" \
        >"$area_output/facts/$name.json"
    done

    # The kernel's read-only entity catalog is the only source of entity kind;
    # the effective-fact documents are the only source of movement disposition,
    # cost, reasons, and light. The compiler reads those documents and never
    # the package's World IR, receipts, or source.
    target/debug/nomos entity-catalog "$area_rel/world" \
      >"$area_output/entity-catalog.json"
    target/debug/nomos-render-plan \
      --catalog "$area_output/entity-catalog.json" \
      --facts "$area_output/facts" \
      --runs "$area_output/runs" \
      --world "$area_output/world" \
      --source "$area_dir/presentation.json" \
      --out "$area_output/rendering-plan.json"
    node "$experiment_dir/src/capture.mjs" \
      "$area_output/rendering-plan.json" "$area_output/frames"
  done

  # The route graph is the compiler's, not JavaScript's: `build-collection.mjs`
  # was deleted by issue #152 and `nomos.area_collection@1` is declared by
  # crates/nomos-render-plan/src/collection.rs.
  target/debug/nomos-render-plan collection \
    --plans "$output_dir/areas" \
    --out "$output_dir/areas.json"
  node "$experiment_dir/src/capture-collection.mjs" \
    "$output_dir/areas.json" "$output_dir/areas" "$output_dir/frames"
  node "$experiment_dir/src/route-expectations.mjs" \
    "$output_dir/areas.json" "$output_dir/areas" "$output_dir/route-expectations.json"
}

case "$mode" in
  capture)
    build
    if command -v rsvg-convert >/dev/null 2>&1; then
      rsvg-convert "$output_dir/frames/contact-sheet.svg" \
        --output "$output_dir/frames/contact-sheet.png"
    fi
    printf 'Executable gaol captured at %s\n' "$output_dir/frames/contact-sheet.svg"
    ;;
  verify)
    build
    node --test "$experiment_dir/src/"*.test.mjs
    node "$experiment_dir/src/verify.mjs" --collection \
      "$output_dir/areas.json" \
      "$experiment_dir/area-collection.example.json" \
      "$output_dir/areas"
    cmp "$output_dir/route-expectations.json" "$experiment_dir/route-expectations.json"
    for area_dir in "$areas_dir"/*; do
      [[ -d $area_dir ]] || continue
      area_id=$(basename "$area_dir")
      cmp "$output_dir/areas/$area_id/rendering-plan.json" "$area_dir/rendering-plan.example.json"
      node "$experiment_dir/src/verify.mjs" \
        "$output_dir/areas/$area_id/rendering-plan.json" \
        "$output_dir/areas/$area_id/frames/contact-sheet.svg"
    done
    ;;
  accept)
    build
    for area_dir in "$areas_dir"/*; do
      [[ -d $area_dir ]] || continue
      area_id=$(basename "$area_dir")
      cp "$output_dir/areas/$area_id/rendering-plan.json" "$area_dir/rendering-plan.example.json"
      printf 'wrote %s\n' "${area_dir#"$repo_root/"}/rendering-plan.example.json"
    done
    cp "$output_dir/areas.json" "$experiment_dir/area-collection.example.json"
    printf 'wrote %s\n' "${experiment_dir#"$repo_root/"}/area-collection.example.json"
    cp "$output_dir/route-expectations.json" "$experiment_dir/route-expectations.json"
    printf 'wrote %s\n' "${experiment_dir#"$repo_root/"}/route-expectations.json"
    ;;
  *)
    printf 'usage: %s [capture|verify|accept]\n' "$0" >&2
    exit 64
    ;;
esac
